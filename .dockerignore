# Allow only application/build inputs into the context, including untracked files.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!README.md
!MANIFEST.in
!requirements.txt
!requirements/
requirements/**
!requirements/build.lock
!requirements/runtime.lock
!gpuroster/
gpuroster/**
!gpuroster/*.py
!gpuroster/monitoring/
gpuroster/monitoring/**
!gpuroster/monitoring/*.py
!gpuroster/templates/
gpuroster/templates/**
!gpuroster/templates/*.html
!gpuroster/static/
gpuroster/static/**
!gpuroster/static/*.js
!gpuroster/static/*.css
!gpuroster/static/vendor/
gpuroster/static/vendor/**
!gpuroster/static/vendor/*.js
!gpuroster/static/vendor/*.LICENSE.txt
